{
  "enabled": true,
  "pollMs": 5000,
  "notifyGroupEnv": "BIGFISH_PLAY_GROUP",
  "autoLaunchEmulator": false,
  "cooldownMinutes": 60,
  "missingGameReminderMinutes": 360,
  "gameAliases": {
    "明日方舟": "com.hypergryph.arknights",
    "命运-冠位指定": "com.bilibili.fatego",
    "FGO": "com.bilibili.fatego"
  },
  "autonomy": {
    "enabled": true,
    "notifyOnSkip": false,
    "decisionTimeoutMinutes": 5,
    "maxSessionMinutes": 12,
    "maxActions": 30,
    "webSearch": true,
    "objective": "像自己真心想玩一样探索当前游戏，能玩就连续玩，卡住或界面不确定就停。",
    "forbiddenActions": [
      "充值",
      "购买",
      "看广告领奖励",
      "开通会员",
      "修改账号",
      "删除数据",
      "交易"
    ]
  },
  "maa": {
    "enabled": true,
    "profile": "runtime",
    "adbPath": "${ADB}",
    "maxRuntimeMinutes": 20,
    "taskAllowlist": [
      "arknights-safe"
    ],
    "safeTasks": {
      "com.hypergryph.arknights": "arknights-safe"
    },
    "supportedResolutions": [
      [1280, 720],
      [1920, 1080]
    ],
    "fallbackOnPreflightFailure": true
  },
  "targets": []
}
